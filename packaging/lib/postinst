#!/bin/sh
# Shared postinst for every core-apps package built by this packaging/ tree. Each package stages
# its whole app/framework directory as a single /media/cryptofs/core-apps-overwrite/<pkg-name>/payload.tar.gz
# plus a dest.txt naming the real absolute path it replaces (a single ipk only ever ships ONE such
# subdirectory -- the per-package name just keeps multiple packages' payloads from colliding on
# the same tracked filename at the ipkg level). Backs up whatever's currently there (once, as a
# single tar -- not per-file: these are whole-directory replacements, not surgical patches) so
# prerm can restore it, then replaces the whole directory with this package's payload.
#
# The payload is ONE tarball, not thousands of loose files in data.tar.gz: confirmed live that
# ipkg's own offline-root extraction of ~2800 loose files took ~139s, vs ~34s for a plain `tar xzf`
# of the identical bytes -- ipkg's own per-file bookkeeping (not raw cryptofs FUSE throughput) is
# the bottleneck. Shipping one tarball means ipkg only ever extracts one file; this script does
# the real many-small-files extraction itself, straight to the final destination.
set +e
# The App Installer runs this script with its working directory set to the package's app directory
# (/media/cryptofs/apps/usr/palm/applications/<pkg-id>) -- which for com.palm.app.contacts and
# com.palm.app.messaging is exactly the directory dest.txt names and `rm -rf "$DST"` below deletes.
# Once the cwd is gone, GNU tar fails getcwd() before it ever honours -C ("tar: Cannot save working
# directory") and exits 2, so the extraction "fails", the script rolls back, and the device is left
# with no Contacts/Messaging app at all. Anchor ourselves somewhere that cannot be deleted first.
cd /
BAK_ROOT=/media/cryptofs/core-apps-backup
log() { echo "[core-apps] $*"; }

mount -o remount,rw /dev/mapper/store-root / 2>/dev/null
mount -o remount,rw / 2>/dev/null

# Derive our own package id from how this script was invoked: either the direct-install path
# (/usr/lib/ipkg/info/<pkg-id>.postinst, confirmed live) or the Preware/WOSQI offline-root path
# (/media/cryptofs/apps/.scripts/<pkg-id>/pmPostInstall.script, also confirmed live). stage_whole's
# <pkg-name> parameter is always identical to PKG_ID for every package built by this tree, so this
# lets us look up EXACTLY our own staged subdirectory instead of blindly taking whichever
# subdirectory happens to have a dest.txt first -- unsafe if more than one package's staged data
# is ever present at once (e.g. if the App Installer doesn't fully process one package before
# extracting the next; not something this session could verify either way, so guard against it).
case "$0" in
  */pmPostInstall.script) PKGID="$(basename "$(dirname "$0")")" ;;
  *.postinst) PKGID="$(basename "$0" .postinst)" ;;
  *) PKGID="" ;;
esac

OV=""
if [ -n "$PKGID" ]; then
  for base in /media/cryptofs/core-apps-overwrite /media/cryptofs/apps/media/cryptofs/core-apps-overwrite; do
    [ -f "$base/$PKGID/dest.txt" ] && OV="$base/$PKGID" && break
  done
fi
# Fallback (should never trigger given the above -- kept only in case PKGID derivation ever fails
# for an invocation pattern this session didn't see): old "first match" behavior.
if [ -z "$OV" ]; then
  for d in /media/cryptofs/core-apps-overwrite/*/ /media/cryptofs/apps/media/cryptofs/core-apps-overwrite/*/; do
    [ -f "${d}dest.txt" ] && OV="${d%/}" && break
  done
fi

# WebOSQuickInstall (confirmed live) runs this SAME pmPostInstall.script a second time itself,
# after the real App-Installer-driven install already ran it once and cleaned up $OV -- a second
# run legitimately finds nothing staged, which used to be a hard error here ("no dest.txt found").
# That's not a real failure, just harmless redundancy: LASTDEST (written on success below, and
# NEVER cleaned up like $OV is) records where we last installed this exact PKGID. If it says we
# already installed successfully and that destination still exists, this is a no-op, not an error.
LASTDEST="/media/cryptofs/core-apps-overwrite/.last-installed/$PKGID.dest.txt"
if [ -z "$OV" ]; then
  if [ -n "$PKGID" ] && [ -f "$LASTDEST" ] && [ -d "$(cat "$LASTDEST")" ]; then
    log "nothing newly staged for $PKGID -- already installed at $(cat "$LASTDEST"), treating as a no-op"
    exit 0
  fi
  echo "!! no core-apps-overwrite/*/dest.txt found (checked direct + offline-root paths), nothing to install" >&2
  exit 1
fi

DST="$(cat "$OV/dest.txt")"
BAK="$BAK_ROOT$(echo "$DST" | tr '/' '_').tar"

mkdir -p "$BAK_ROOT"

# A one-entry tar is a backup of an empty directory: a restore point that restores nothing. Treat it
# as absent so it is rebuilt rather than trusted forever -- the "back up once" test below only asks
# whether the file exists.
bak_is_usable() { [ -f "$1" ] && [ "$(tar tf "$1" 2>/dev/null | head -3 | wc -l)" -gt 1 ]; }

# What gets backed up may be incomplete, and that is worth understanding rather than working around:
# Preware replaces an installed package with remove-then-install, so for an app webOS itself manages
# as an ipkg package (com.palm.app.contacts, com.palm.app.messaging on a TouchPad) ipkg has already
# deleted the files it tracked by the time this runs.
#
# That is survivable without any special machinery. Once our package is uninstalled it is no longer
# registered, and webOS's own boot-time app-install service reinstalls the stock ipk from
# /usr/palm/ipkgs on the next restart -- confirmed live on a 3.0.5 TouchPad. So the recovery for a
# missing or broken core app is simply: uninstall, then REBOOT, and stock comes back by itself.
if ! bak_is_usable "$BAK"; then
  rm -f "$BAK"
  if [ -d "$DST" ] && [ -n "$(ls -A "$DST" 2>/dev/null)" ]; then
    ( cd "$(dirname "$DST")" && tar cf "$BAK" "$(basename "$DST")" ) \
      && log "backed up stock $DST -> $BAK"
  else
    log "nothing complete at $DST to back up -- the package manager removed it before this ran."
    log "  uninstall will remove our copy; reboot afterwards and webOS reinstalls the stock app."
  fi
fi

rm -rf "$DST"
mkdir -p "$DST"
tar -C "$DST" --no-same-owner -xzf "$OV/payload.tar.gz"
TAR_STATUS=$?

# This whole script runs under `set +e` (a failed step shouldn't abort a postinst mid-way through
# other packages' installs), which means a corrupted/truncated payload.tar.gz (confirmed live: a
# bad transfer left com.palm.app.messaging silently "installed" into an EMPTY directory - ipkg and
# this script both reported success, and only .last-installed even hinted anything happened) would
# otherwise go completely unnoticed. Explicitly check both tar's own exit status AND that
# extraction actually produced something (a truncated-but-still-gzip-valid archive can exit 0 with
# partial content) - roll back to the pre-install backup if we have one, so a bad transfer leaves
# the previous working install in place instead of a broken empty directory, and fail loudly
# either way instead of silently recording success.
if [ "$TAR_STATUS" -ne 0 ] || [ -z "$(ls -A "$DST" 2>/dev/null)" ]; then
  echo "!! extraction of $OV/payload.tar.gz into $DST failed (tar exit $TAR_STATUS, $([ -z "$(ls -A "$DST" 2>/dev/null)" ] && echo empty || echo non-empty) result) - likely a corrupted/truncated transfer" >&2
  if [ -f "$BAK" ]; then
    rm -rf "$DST"
    ( cd "$(dirname "$DST")" && tar xf "$BAK" ) && log "rolled back to pre-install backup at $DST"
  fi
  exit 1
fi

# Recreate any symlinks stage_whole had to leave out of the payload (cryptofs, where the payload
# was staged, rejects symlink() outright) -- $DST is on root fs, which supports them fine.
if [ -s "$OV/symlinks.txt" ]; then
  while IFS="$(printf '\t')" read -r relpath target; do
    [ -n "$relpath" ] || continue
    mkdir -p "$DST/$(dirname "$relpath")"
    ln -sf "$target" "$DST/$relpath"
  done < "$OV/symlinks.txt"
fi
log "installed $DST"

# Provision any db8 kind/permission schema files (stage_db8_schema) to their real, system-wide
# location -- see stage_db8_schema's comment in common.sh for why this is required at all (confirmed
# live: com.palm.app.phone's own kinds/permissions were silently deleted by installing our
# repackaged ipk as a stock upgrade). putKind/putPermissions must be called explicitly with the
# kind's own declared owner in the payload itself (db8 returns error 22 "required property not
# found - 'owner'" otherwise) -- dropping the files at the real path alone is not enough for an
# already-booted device to pick them up. Idempotent, safe to re-run on every install/upgrade.
if [ -d "$OV/db8-kinds" ] || [ -d "$OV/db8-permissions" ]; then
  mkdir -p /etc/palm/db/kinds /etc/palm/db/permissions
  for f in "$OV/db8-kinds"/*; do
    [ -f "$f" ] || continue
    name="$(basename "$f")"
    cp "$f" "/etc/palm/db/kinds/$name"
    owner="$(grep '"owner"' "$f" | head -1 | sed 's/.*: *"//; s/".*//')"
    [ -n "$owner" ] || owner="$PKGID"
    content="$(cat "$f")"
    if [ -z "$(grep '"owner"' "$f")" ]; then
      # Inject "owner" after the FIRST '{' in the file, wherever it is -- NOT a line-1-anchored
      # sed (confirmed live: com.palm.phonecall/com.palm.phonecallgroup both open with a /* ... */
      # comment BEFORE their '{', so "1s/^{/.../" silently no-ops and the kind still lacks "owner").
      # awk here, not GNU sed's 0,/{/{s///} range -- BusyBox sed on-device doesn't support that
      # range-address syntax and silently no-ops on it too.
      content="$(printf '%s' "$content" | awk -v owner="$owner" '!done && /\{/{sub(/\{/, "{\"owner\":\"" owner "\",");done=1} {print}')"
    fi
    reply="$(luna-send -i -n 1 -a "$owner" -f palm://com.palm.db/putKind "$content" 2>&1 </dev/null)"
    if echo "$reply" | grep -q '"returnValue"[[:space:]]*:[[:space:]]*true'; then
      log "  provisioned db8 kind $name (owner $owner)"
    else
      log "  !! putKind failed for $name (owner $owner): $reply"
    fi
  done
  for f in "$OV/db8-permissions"/*; do
    [ -f "$f" ] || continue
    name="$(basename "$f")"
    cp "$f" "/etc/palm/db/permissions/$name"
    owner="$(grep '"owner"' "/etc/palm/db/kinds/$name" 2>/dev/null | head -1 | sed 's/.*: *"//; s/".*//')"
    [ -n "$owner" ] || owner="$PKGID"
    reply="$(luna-send -i -n 1 -a "$owner" -f palm://com.palm.db/putPermissions "{\"permissions\":$(cat "$f")}" 2>&1 </dev/null)"
    if echo "$reply" | grep -q '"returnValue"[[:space:]]*:[[:space:]]*true'; then
      log "  provisioned db8 permissions $name (owner $owner)"
    else
      log "  !! putPermissions failed for $name (owner $owner): $reply"
    fi
  done
fi

# Record where we just installed, OUTSIDE $OV (which is about to be wiped below) -- this is what
# lets a redundant second invocation (see WebOSQuickInstall comment above) recognize "already done"
# instead of misreporting a real failure.
if [ -n "$PKGID" ]; then
  mkdir -p "$(dirname "$LASTDEST")"
  echo "$DST" > "$LASTDEST"
fi

# Clean up our own staged copy now that it's been applied -- if left in place, a LATER package's
# postinst glob (/media/cryptofs/core-apps-overwrite/*/dest.txt) would find this STALE subdirectory before its
# own freshly-extracted one and silently reinstall the WRONG payload (confirmed live: installing
# accounts then phone then messaging.library then contacts.plugin.messaging all "installed" only
# com.palm.app.accounts, since its leftover subdir was never removed and kept winning the glob).
rm -rf "$OV"

# Nudge anything that might have this cached to reload.
#
# nudge_kill matches on cmdline but never signals our own installer chain: under the App Installer
# this script runs as `sh -c .../.scripts/<pkg-id>/pmPostInstall.script`, and ipkg and
# ApplicationInstallerUtility both carry the package name or the .ipk path in their cmdline. An
# unqualified match therefore SIGTERMs the installer whenever the swept string is a substring of the
# package's own id -- the package installs correctly, but webOS reports FAILED_IPKG_INSTALL and
# Preware aborts every remaining package in the batch (and, because Preware only refreshes its
# installed list on Update Feeds, retrying just replays the same package forever).
nudge_kill() {
  pat="$1"
  for p in /proc/[0-9]*; do
    pid="${p##*/}"
    [ "$pid" = "$$" ] && continue
    grep -qa -e pmPostInstall -e pmPreRemove -e ApplicationInstallerUtility -e /usr/lib/ipkg/ -e '\.ipk' "$p/cmdline" 2>/dev/null && continue
    grep -qa "$pat" "$p/cmdline" 2>/dev/null && kill "$pid" 2>/dev/null
  done
}
luna-send -n 1 luna://com.palm.applicationManager/rescan '{}' >/dev/null 2>&1
nudge_kill 'com.palm.service.accounts.js'
nudge_kill 'contacts.linker'

# Deliberately NOT remounting root back to read-only here -- ipkg writes its own bookkeeping after
# postinst returns, and that needs root writable too.
log "install complete. Restart the UI to pick up patched app/framework JS: stop LunaSysMgr; start LunaSysMgr"
exit 0
