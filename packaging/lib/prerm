#!/bin/sh
# Shared prerm for every core-apps package built by this packaging/ tree -- restores the whole
# directory postinst backed up (as a single tar), or removes it if it never existed on stock.
# prerm runs BEFORE ipkg deletes this package's own tracked files, so
# /media/cryptofs/core-apps-overwrite/<pkg-name>/dest.txt (part of this package's payload) is still present
# and readable here.
set +e
# The App Installer runs this script with its working directory set to the package's app directory
# (/media/cryptofs/apps/usr/palm/applications/<pkg-id>) -- which for com.palm.app.contacts and
# com.palm.app.messaging is exactly the directory dest.txt names and `rm -rf "$DST"` below deletes.
# Once the cwd is gone, GNU tar fails getcwd() before it ever honours -C ("tar: Cannot save working
# directory") and exits 2, so the extraction "fails", the script rolls back, and the device is left
# with no Contacts/Messaging app at all. Anchor ourselves somewhere that cannot be deleted first.
cd /
BAK_ROOT=/media/cryptofs/core-apps-backup
log() { echo "[core-apps] $*"; }

mount -o remount,rw /dev/mapper/store-root / 2>/dev/null
mount -o remount,rw / 2>/dev/null

# See postinst's matching comment: pmPreRemove.script (this file, via make-ipk.sh) is what
# Preware/WOSQI actually run, and grabbing "whichever subdirectory has a dest.txt" instead of
# EXACTLY our own is unsafe if more than one package's staged data is ever present at once.
case "$0" in
  */pmPreRemove.script) PKGID="$(basename "$(dirname "$0")")" ;;
  *.prerm) PKGID="$(basename "$0" .prerm)" ;;
  *) PKGID="" ;;
esac

OV=""
if [ -n "$PKGID" ]; then
  for base in /media/cryptofs/core-apps-overwrite /media/cryptofs/apps/media/cryptofs/core-apps-overwrite; do
    [ -f "$base/$PKGID/dest.txt" ] && OV="$base/$PKGID" && break
  done
fi
if [ -z "$OV" ]; then
  for d in /media/cryptofs/core-apps-overwrite/*/ /media/cryptofs/apps/media/cryptofs/core-apps-overwrite/*/; do
    [ -f "${d}dest.txt" ] && OV="${d%/}" && break
  done
fi

# postinst deletes $OV as its last act (so a later package's glob can't find a stale subdirectory),
# which means the lookups above find NOTHING on any normal uninstall -- the restore below was
# silently skipped and the replaced app was left in place forever, with its backup orphaned. Fall
# back to the destination postinst recorded outside $OV for exactly this kind of lookup.
DST=""
[ -n "$OV" ] && DST="$(cat "$OV/dest.txt")"
LASTDEST="/media/cryptofs/core-apps-overwrite/.last-installed/$PKGID.dest.txt"
if [ -z "$DST" ] && [ -n "$PKGID" ] && [ -f "$LASTDEST" ]; then
  DST="$(cat "$LASTDEST")"
fi

# Both sources are file contents, and everything below starts with rm -rf: refuse anything that is
# not an absolute path.
case "$DST" in /?*) ;; *) DST="" ;; esac

if [ -n "$DST" ]; then
  BAK="$BAK_ROOT$(echo "$DST" | tr '/' '_').tar"
  rm -rf "$DST"
  if [ -f "$BAK" ]; then
    ( cd "$(dirname "$DST")" && tar xf "$BAK" )
    rm -f "$BAK"
    log "restored stock $DST"
  else
    log "removed $DST (was never on stock)"
  fi
  # Only now is the recorded destination expendable. Leaving it would make a SECOND uninstall call
  # (WOSQI is known to make one) rm -rf the stock app that the first call just restored.
  rm -f "$LASTDEST"
fi

# Fire-and-forget -- NEVER wait for this one. `luna-send -n 1` blocks until applicationManager
# replies, but under the App Installer this script runs INSIDE LunaSysMgr's own request handling, so
# the service that owes the reply is the same one waiting for this script to exit. Nothing times out,
# so the install chain and the UI both hang forever (observed live: Preware stuck on "[core-apps]
# removal complete", luna-send visible blocked in the process tree, the whole batch dead until that
# one call was killed by hand). The rescan is only a nudge -- launch it and move on.
( luna-send -n 1 luna://com.palm.applicationManager/rescan '{}' >/dev/null 2>&1 & ) >/dev/null 2>&1

# Deliberately NOT remounting root back to read-only here -- same reasoning as postinst.
log "removal complete."
exit 0
