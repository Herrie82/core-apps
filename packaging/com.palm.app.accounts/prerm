#!/bin/sh
# Uninstaller for the webOS Archive build of com.palm.app.accounts: puts HP's stock
# app back exactly as it was. Runs as ROOT via Preware / ipkgservice, or as
# pmPreRemove.script under WebOSQuickInstall.
#
# Reads the destination from a state file rather than from the staged payload's
# dest.txt. That distinction is the whole point: postinst deletes the staged
# directory once it has been applied, so by the time anyone uninstalls, a
# dest.txt-based lookup finds nothing, skips the restore silently, and leaves the
# replaced app in place forever. (That is exactly the failure mode in the sibling
# core-apps packaging, whose prerm looks for a dest.txt that postinst removed.)
set +e

APPID=com.palm.app.accounts
DST=/usr/palm/applications/$APPID
STATE=/media/cryptofs/webosarchive-accounts
BAK="$STATE/stock-app.tar"
MARKER="$STATE/installed"

# Must match postinst's OURS_MARKER exactly — this is how the no-backup branch
# below tells "our build, safe to remove" from "already restored by an earlier
# call, do not touch".
OURS_MARKER="source/palmID/UsernameDialog.js"

log() { echo "[wosa-accounts] $*"; }

mount -o remount,rw /dev/mapper/store-root / 2>/dev/null
mount -o remount,rw / 2>/dev/null

# Trust the marker if present, but fall back to the known path: a missing marker
# should not mean "leave our build installed".
if [ -f "$MARKER" ]; then
    RECORDED="$(cat "$MARKER")"
    [ -n "$RECORDED" ] && DST="$RECORDED"
fi

if [ ! -f "$BAK" ]; then
    # No backup on file means one of two things, and they call for OPPOSITE
    # actions — which is why this checks what is actually installed rather than
    # just the absence of $BAK:
    #
    #   1. The app was never on the device before us (first install had nothing to
    #      back up). $DST is our build. Removing it is the correct inverse.
    #   2. This is a SECOND invocation of this same uninstall (confirmed live for
    #      postinst under WOSQI — postinst guards against it explicitly; prerm did
    #      not, and that omission was the bug). The first call already restored
    #      stock and deleted $BAK as its very last step. $DST is now stock, not
    #      ours. Blindly removing it here — which is what this branch used to do —
    #      deleted the stock app that had just been put back, leaving NEITHER
    #      version installed. Confirmed by reproducing it: a second prerm call
    #      turned a successful restore into a missing app directory.
    #
    # OURS_MARKER is the same file postinst uses to tell "ours" from "stock", so
    # case 1 and case 2 are distinguishable without any extra state.
    if [ -f "$DST/$OURS_MARKER" ]; then
        log "no stock backup found — removing our build at $DST"
        rm -rf "$DST"
    else
        log "no stock backup found and $DST is not our build — nothing to do (already restored by an earlier call?)"
    fi
    rm -f "$MARKER"
    luna-send -n 1 palm://com.palm.applicationManager/rescan '{}' >/dev/null 2>&1
    exit 0
fi

# Restore into a temp dir first and only swap on success, so a corrupt backup leaves
# the working (if unwanted) app in place instead of no app at all.
TMP="$STATE/restore.$$"
rm -rf "$TMP"; mkdir -p "$TMP"
( cd "$TMP" && tar xf "$BAK" )
if [ $? -ne 0 ] || [ -z "$(ls -A "$TMP" 2>/dev/null)" ]; then
    echo "!! could not read $BAK — leaving $DST as it is rather than removing it" >&2
    rm -rf "$TMP"
    exit 1
fi

rm -rf "$DST"
mv "$TMP/$(basename "$DST")" "$DST"
rm -rf "$TMP"
# Only now is the backup expendable.
rm -f "$BAK" "$MARKER"
log "restored stock $DST"

luna-send -n 1 palm://com.palm.applicationManager/rescan '{}' >/dev/null 2>&1
log "removal complete. Restart the UI to pick up the restored app: stop LunaSysMgr; start LunaSysMgr"
exit 0
